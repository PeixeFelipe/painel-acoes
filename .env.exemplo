# MODELO. Copie este arquivo com o nome ".env" e preencha.
# O arquivo ".env" NUNCA deve ser enviado a ninguém: ele guarda a senha do administrador.

# Dados do primeiro administrador (usados só na PRIMEIRA vez que o app roda,
# quando ainda não existe nenhum usuário).
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-por-uma-senha-forte
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com.br
